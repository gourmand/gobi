{
  "name": "@gourmanddev/core",
  "version": "2.0.0",
  "description": "The Gobi Core contains functionality that can be shared across web, VS Code, or Node.js",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "vitest": "vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage && open ./coverage/lcov-report/index.html",
    "tsc:check": "tsc -p  --noEmit",
    "build": "tsc -p tsconfig.npm.json",
    "build:pnpm": "pnpm run build && pnpm run sentry:sourcemaps",
    "lint": "eslint  --ext ts",
    "lint:fix": "eslint  --ext ts --fix",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org gobi-xd --project gobi ./dist && sentry-cli sourcemaps upload --org gobi-xd --project gobi ./dist"
  },
  "type": "module",
  "author": "gourmand.dev",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gourmand/gobi"
  },
